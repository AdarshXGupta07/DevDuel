# DevDuel judge runner — JavaScript (Node)
# Same rules as the Python runner: pinned, slim, non-root, contains no application code.
FROM node:22.11.0-slim

RUN groupadd --gid 10001 runner \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin runner \
    && mkdir -p /box \
    && chown runner:runner /box

ENV NODE_ENV=production \
    HOME=/tmp

USER 10001:10001
WORKDIR /box

CMD ["node", "-e", "console.log('devduel runner ready')"]
