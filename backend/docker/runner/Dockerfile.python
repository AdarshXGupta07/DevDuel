# DevDuel judge runner — Python
#
# Every line here is deliberate:
#   - a pinned digest-free but *exact* version tag, not `latest`, so a rebuild in three
#     months produces the same judge and not a mystery
#   - slim, because everything installed is extra attack surface for untrusted code
#   - a non-root user with a fixed uid that matches `--user 10001:10001` at run time
#   - NO application code. This image knows nothing about DevDuel; it runs one file.
FROM python:3.12.7-slim

RUN groupadd --gid 10001 runner \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin runner \
    && mkdir -p /box \
    && chown runner:runner /box

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

USER 10001:10001
WORKDIR /box

# The real command is always supplied by `docker run`; this is only a safe default.
CMD ["python", "-c", "print('devduel runner ready')"]
