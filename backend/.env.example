# Copy to .env and fill in. Never commit the real file.
# Anything without a default here will refuse to boot if missing (ADR-0002).

# --- required ---
SUPABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
APP_ENV=development                  # development | production
JWT_SECRET=                          # openssl rand -hex 32

# --- CORS (ADR-0022). Comma-separated. '*' is refused when APP_ENV=production. ---
CORS_ORIGINS=http://localhost:5173

# --- tokens (ADR-0011) ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- judge (ADR-0020) ---
JUDGE_IMAGE_PYTHON=devduel-runner:py312
JUDGE_IMAGE_NODE=devduel-runner:node22
JUDGE_TIMEOUT_SECONDS=5
JUDGE_MEMORY_MB=256
JUDGE_CPUS=0.5
JUDGE_PIDS_LIMIT=64
JUDGE_MAX_OUTPUT_BYTES=65536
JUDGE_MAX_CONCURRENT=4

# --- duel rules ---
DUEL_TIME_LIMIT_SECONDS=900
COUNTDOWN_SECONDS=5
DISCONNECT_GRACE_SECONDS=30          # ADR-0018
RANKED_DAILY_LIMIT=2                 # free tier
DAILY_RESET_TIMEZONE=Asia/Kolkata    # ADR-0024

# --- AI features (ADR-0038). Leave blank and the AI endpoints report themselves
# disabled; the UI hides the review panel rather than showing a broken one. ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=medium                     # low | medium | high | xhigh | max
AI_MAX_TOKENS=4000
AI_TIMEOUT_SECONDS=90

# --- billing / Razorpay (ADR-0032). Leave blank to disable billing entirely. ---
# Test keys start rzp_test_ and are refused when APP_ENV=production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=             # set in the Razorpay webhook config; required in prod
RAZORPAY_PLAN_ID=                    # created in the Razorpay dashboard (₹50 monthly)
SUBSCRIPTION_AMOUNT_PAISE=5000
SUBSCRIPTION_TOTAL_COUNT=120
BILLING_GRACE_DAYS=3
